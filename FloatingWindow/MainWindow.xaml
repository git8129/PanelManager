<Window x:Class="FloatingWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floating Icon"
        Width="160" Height="160"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Visibility="Hidden"
        MouseDoubleClick="Window_MouseDoubleClick"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- 定义悬停效果的动画 -->
        <Storyboard x:Key="HoverInAnimation">
            <DoubleAnimation Storyboard.TargetName="FloatingBall"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                           To="1.05" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FloatingBall"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                           To="1.05" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FloatingBall"
                           Storyboard.TargetProperty="Opacity"
                           To="1.0" Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Key="HoverOutAnimation">
            <DoubleAnimation Storyboard.TargetName="FloatingBall"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                           To="1.0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FloatingBall"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                           To="1.0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FloatingBall"
                           Storyboard.TargetProperty="Opacity"
                           To="0.92" Duration="0:0:0.2"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- 悬浮球容器 -->
        <Border x:Name="FloatingBall"
                Width="96" Height="96"
                CornerRadius="48"
                Background="#B4191E23"
                BorderBrush="#64FFFFFF"
                BorderThickness="1.5"
                Opacity="0.92"
                RenderTransformOrigin="0.5,0.5"
                MouseEnter="FloatingBall_MouseEnter"
                MouseLeave="FloatingBall_MouseLeave"
                Cursor="Hand">

            <Border.Effect>
                <DropShadowEffect Color="Black"
                                BlurRadius="32"
                                ShadowDepth="4"
                                Opacity="0.5"
                                Direction="270"/>
            </Border.Effect>

            <Border.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>

            <!-- 右键菜单 -->
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="恢复主窗口" Click="MenuItem_Restore_Click">
                        <MenuItem.Icon>
                            <TextBlock Text="🔄" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="更换图标..." Click="MenuItem_ChangeIcon_Click">
                        <MenuItem.Icon>
                            <TextBlock Text="🖼️" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="退出程序" Click="MenuItem_ExitApp_Click">
                        <MenuItem.Icon>
                            <TextBlock Text="⛔" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Border.ContextMenu>

            <!-- 图标 -->
            <Image x:Name="IconImage"
                   Width="58" Height="58"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
